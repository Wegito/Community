# Copy to .env and fill in. Never commit .env.

# development | testing | production (default: production)
APP_ENV=production

# Required in production: long random value, e.g.
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Display name of the club in the UI
CLUB_NAME=Community

# Public base URL, e.g. https://community.example.org (used for links in emails).
# Required in production: password reset links must not depend on the request's Host header.
BASE_URL=

# Database (SQLite file in the instance/ folder by default)
SQLALCHEMY_DATABASE_URI=sqlite:///community.db

# Number of reverse proxies in front of the app (1 behind Nginx, 0 when none)
TRUSTED_PROXY_HOPS=0

# Cookies: leave empty for the default (true in production, false in development).
# Set false only if production is served without HTTPS; otherwise login fails over plain HTTP.
SESSION_COOKIE_SECURE=
SESSION_COOKIE_SAMESITE=Lax

# Email. MAIL_BACKEND: smtp | console (only logs mails) | memory (tests).
# Empty = smtp when MAIL_SERVER is set, otherwise console. Mails are sent by `flask jobs tick`.
MAIL_BACKEND=
MAIL_SERVER=
# Empty = defaults: STARTTLS on port 587. For implicit TLS on port 465 set only MAIL_USE_SSL=true.
MAIL_PORT=
MAIL_USE_TLS=
MAIL_USE_SSL=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM="Community <noreply@localhost>"

# Background jobs: tries before a job is marked failed
JOB_MAX_ATTEMPTS=5

# Days the audit log keeps IP addresses; `flask jobs tick` removes older ones once a day
AUDIT_IP_RETENTION_DAYS=90

# Personal invitations: link and email invitations stay valid this many days,
# a QR code shown on the inviter's phone this many hours.
INVITE_LINK_DAYS=14
INVITE_QR_HOURS=24

# Password reset ("Passwort vergessen?"): minutes a reset link stays valid
PASSWORD_RESET_MAX_AGE_MINUTES=60
