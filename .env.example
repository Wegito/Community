# Copy to .env and fill in. Never commit .env.

# development | testing | production (default: production)
APP_ENV=production

# Required in production: long random value, e.g.
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Shared registration code (temporary until personal invites, roadmap M1-7).
# Leave empty to close registration.
INVITE_CODE=

# Display name of the club in the UI
CLUB_NAME=Community

# Public base URL, e.g. https://community.example.org
BASE_URL=

# Database (SQLite file in the instance/ folder by default)
SQLALCHEMY_DATABASE_URI=sqlite:///community.db

# Number of reverse proxies in front of the app (1 behind Nginx, 0 when none)
TRUSTED_PROXY_HOPS=0

# Cookies: true when served over HTTPS (default in production: true)
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax
